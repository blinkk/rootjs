    "test:prod": "pnpm run build && node scripts/test.mjs",
    "types": "root-cms generate-types"
  },
  "dependencies": {
    "@blinkk/root": "workspace:*",
    "@blinkk/root-cms": "workspace:*",
    "@blinkk/root-password-protect": "workspace:*",
    "firebase-admin": "14.4.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
