{
  "name": "@examples/blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run types && root dev",
    "build": "rm -rf dist/ && root build",
    "preview": "rm -rf dist/ && root build --ssr-only && root preview",
