{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "pretty": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "es2020",
    "rootDir": "..",
    "outDir": "dist",
    "types": [
      "@types/gapi",
      "@types/gapi.client.drive-v3",
      "@types/gapi.client.sheets-v4",
      "@types/google.accounts",
      "@vitest/browser/matchers",
      "vite/client"
    ],
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react": ["../node_modules/preact/compat/src/index.d.ts"],
      "react/jsx-runtime": ["../node_modules/preact/jsx-runtime/src/index.d.ts"],
      "react-dom": ["../node_modules/preact/compat/src/index.d.ts"],
      "react-dom/*": ["../node_modules/preact/compat/*"]
    }
  },
  "include": [
    "*.ts",
    "**/*.ts",
    "*.tsx",
    "**/*.tsx",
    "../shared/*.ts",
    "../shared/*.tsx"
  ]
}
