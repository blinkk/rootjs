{
  "name": "@blinkk/root",
  "version": "3.4.10",
  "author": "s@blinkk.com",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkk/rootjs.git",
    "directory": "packages/root"
  },
  "files": [
    "bin/*",
    "dist/**/*",
    "client.d.ts"
  ],
  "bin": {
    "root": "./bin/root.js"
  },
  "type": "module",
  "module": "./dist/core.js",
  "types": "./dist/core/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/core.d.ts",
      "import": "./dist/core.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./client": "./client.d.ts",
    "./core": {
      "types": "./dist/core/core.d.ts",
      "import": "./dist/core.js"
    },
    "./functions": {
      "types": "./dist/functions/functions.d.ts",
      "import": "./dist/functions.js"
    },
    "./jsx": {
      "types": "./dist/jsx/jsx.d.ts",
      "import": "./dist/jsx.js"
    },
    "./jsx/jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "import": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx/jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx/jsx-dev-runtime.js"
    },
    "./middleware": {
      "types": "./dist/middleware/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./node": {
      "types": "./dist/node/node.d.ts",
      "import": "./dist/node.js"
    },
    "./render": {
      "types": "./dist/render/render.d.ts",
      "import": "./dist/render.js"
    },
    "./utils": {
      "types": "./dist/utils/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-esbuild.mjs ./esbuild.config.json",
    "dev": "nodemon --watch src -e ts,tsx --exec pnpm build",
    "test": "pnpm build && vitest run --test-timeout=30000",
    "test:watch": "pnpm build && vitest"
  },
  "dependencies": {
    "@types/micromatch": "4.0.10",
    "bundle-require": "5.1.0",
    "busboy": "1.6.0",
    "commander": "15.0.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "express": "5.2.1",
    "fs-extra": "11.4.0",
    "html-minifier-terser": "7.2.0",
    "js-beautify": "2.0.3",
    "js-yaml": "5.2.2",
    "kleur": "4.1.5",
    "micromatch": "4.0.8",
    "sass-embedded": "1.100.0",
    "sirv": "3.0.2",
    "source-map-support": "0.5.21",
    "tiny-glob": "0.2.9",
    "vite": "8.2.0",
    "workspace-tools": "0.42.0"
  },
  "peerDependencies": {
    "firebase-admin": ">=11",
    "firebase-functions": ">=4",
    "preact": ">=10",
    "preact-render-to-string": ">=5"
  },
  "peerDependenciesMeta": {
    "firebase-functions": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "preact-render-to-string": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/html-minifier-terser": "7.0.2",
    "@types/js-beautify": "1.14.3",
    "@types/node": "24.13.3",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2",
    "nodemon": "3.1.14",
    "preact": "10.29.7",
    "preact-render-to-string": "6.7.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
