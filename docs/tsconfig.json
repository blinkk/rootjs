{
  "compilerOptions": {
    "target": "esnext",
    "module": "node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["@blinkk/root/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "@blinkk/root/jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // Screenshot scenes (Preact, client-side) and scripts (Node) have their own
  // tsconfig files.
  "exclude": ["node_modules", "dist", "screenshots", "scripts"]
}
