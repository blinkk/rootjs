        {
          "name": "root-cms export",
          "aliases": [],
          "usage": "root-cms export [options]",
          "summary": "exports firestore data to a local directory",
          "description": "By default, all content in the Firestore database associated with the CMS will be exported.\n\nA unique new directory will be created for each export.\n\nFile naming conventions: - Documents that act as containers for subcollections are exported as directories containing a `__data.json` file for the document's own data. - Standalone documents are exported as JSON files named after their document ID (e.g. `page.json`). - For collections like ActionLogs and Translations, the document ID (often a hash) is used as the filename.\n\nExample output: <output>/Collections/Pages/Draft/... <output>/Collections/Pages/Published/... <output>/ActionLogs/...",
          "examples": [
            "root-cms export",
            "root-cms export --filter \"Collections/Pages/**\"",
            "root-cms export --filter \"Collections/Pages/**,!Collections/Pages/Draft/**\""
          ],
          "arguments": [],
          "options": [
            {
              "flags": "--filter <pattern>",
              "description": "comma-separated list of glob patterns to filter content (e.g. Collections/Pages/**, !ActionLogs/**)"
            },
            {
              "flags": "--site <siteId>",
              "description": "site id to export (overrides root config)"
            },
            {
              "flags": "--database <databaseId>",
              "description": "firestore database id (overrides root config, default: \"(default)\")"
            },
            {
              "flags": "--project <projectId>",
              "description": "gcp project id (overrides root config)"
            }
          ],
          "subcommands": []
        },
        {
          "name": "root-cms import",
          "aliases": [],
          "usage": "root-cms import [options]",
          "summary": "imports firestore data from a local directory",
          "description": "",
          "examples": [
            "root-cms import --dir export_project_site_20251209t1305",
            "root-cms import --dir export_project_site_20251209t1305 --filter \"Collections/Pages/**\""
          ],
          "arguments": [],
          "options": [
            {
              "flags": "--dir <directory>",
              "description": "directory to import from (required)"
            },
            {
              "flags": "--filter <pattern>",
              "description": "comma-separated list of glob patterns to filter content (e.g. Collections/Pages/**, !ActionLogs/**)"
            },
            {
              "flags": "--site <siteId>",
              "description": "site id to import to (overrides root config)"
            },
            {
              "flags": "--database <databaseId>",
              "description": "firestore database id (overrides root config, default: \"(default)\")"
