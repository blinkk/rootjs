          "name": "root-cms assets.upload",
          "aliases": [],
          "usage": "root-cms assets.upload <paths...> [options]",
          "summary": "uploads files to the asset library",
          "description": "Files are uploaded to the GCS bucket (and registered with the Google Cloud Image service for images when `gci` is enabled). If the folder already has a file with the same name, the asset is replaced and the new file is synced to every draft doc that uses it. Directories are uploaded recursively, mirroring their structure as subfolders.",
          "examples": [
            "root-cms assets.upload ./hero.png",
            "root-cms assets.upload ./hero.png --folder marketing --alt \"Hero image\"",
            "root-cms assets.upload ./new-hero.png --asset-id AbC123dEf456",
            "root-cms assets.upload ./icons --folder brand"
          ],
          "arguments": [
            {
              "name": "paths",
              "required": true,
              "variadic": true,
              "description": ""
            }
          ],
          "options": [
            {
              "flags": "--folder <folder>",
              "description": "asset library folder to upload into, e.g. \"marketing/q1\" (default: root)"
            },
            {
              "flags": "--name <name>",
              "description": "asset name (single file only)"
            },
            {
              "flags": "--asset-id <assetId>",
              "description": "id of an existing asset whose file should be replaced (single file only)"
            },
            {
              "flags": "--alt <text>",
              "description": "alt text for the uploaded file(s)"
            },
            {
              "flags": "--naming-mode <mode>",
              "description": "gcs object naming: \"hash\", \"hash-path\" or \"clean\" (default: folder setting)"
            },
            {
              "flags": "--cache-control <value>",
              "description": "cache-control header for the file(s)"
            },
            {
              "flags": "--no-gci",
              "description": "skip registering images with the gci service"
            },
            {
              "flags": "--no-sync",
              "description": "skip updating docs that use a replaced asset"
            },
            {
              "flags": "--modified-by <email>",
              "description": "email attributed as the author"
            }
          ],
          "subcommands": []
        },
